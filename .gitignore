data/cache/
data/raw/*.zip
data/raw/*.tif

# node
node_modules/
dist/
.vite/

# video files (upload the demo to YouTube, link it in README)
*.mp4
*.mov
*.mkv

# OS / editor
.DS_Store
Thumbs.db
.vscode/
